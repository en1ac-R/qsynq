@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

package "CLI / Interface" {
    [CLI]
    [Config Manager]
}

package "Core" {
    [Sync Manager]
    [Scheduler]
}

package "File System Layer" {
    [File Scanner]
    [File Watcher]
}

package "Index DB" {
    [File Repository]
    [Connection DB]
    [Transaction]
}

package "Logic" {
    [Diff Engine]
    [Conflict Resolver]
}

package "Network" {
    [Transport (SSH/TCP)]
    [Discovery]
}

' CLI
CLI --> [Sync Manager]
CLI --> [Config Manager]

' Core
[Sync Manager] --> [File Scanner]
[Sync Manager] --> [File Watcher]
[Sync Manager] --> [Diff Engine]
[Sync Manager] --> [Scheduler]

' FS → DB (только через Sync Manager)
[File Scanner] --> [Sync Manager]
[File Watcher] --> [Sync Manager]

' DB access
[Sync Manager] --> [File Repository]
[File Repository] --> [Connection DB]
[File Repository] --> [Transaction]

' Logic
[Diff Engine] --> [Conflict Resolver]

' Network
[Sync Manager] --> [Transport (SSH/TCP)]
[Sync Manager] --> [Discovery]

@enduml
